PORT=4173
NODE_ENV=development
APP_ORIGIN=http://localhost:4173
SESSION_DAYS=7

# Email recovery through Resend (https://resend.com)
RESEND_API_KEY=
EMAIL_FROM=EFood <onboarding@resend.dev>

# SMS recovery through Twilio (https://twilio.com)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Order notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

# Production persistence on Vercel
DATABASE_URL=
BLOB_READ_WRITE_TOKEN=

# Google Sheets order webhook (deployed Google Apps Script web app)
GOOGLE_SHEETS_WEBHOOK_URL=
GOOGLE_SHEETS_WEBHOOK_SECRET=

# Admin CMS credentials (store only an scrypt hash, never a plain password)
ADMIN_LOGIN=admin@efood.local
ADMIN_PASSWORD_HASH=
